# Local desktop service configuration
THIMBLE_PORT=18767
# Optional: absolute path to a Python executable used by the desktop shell
# THIMBLE_PYTHON=
# Optional writable locations for packaged/offline deployments
# THIMBLE_DATA_DIR=
# Optional explicit local SQLite file; remains local until a real server adapter is implemented.
# THIMBLE_DB_PATH=
# THIMBLE_OUTPUT_DIR=
# THIMBLE_REPORT_DIR=
# THIMBLE_LOG_PATH=
# Future service address/timeout and import source folder are saved beside the active
# database in data-source.json. Saving these fields does not connect or upload data.
